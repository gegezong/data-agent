{
  "name": "data-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 Pi Coding Agent SDK 的企业销售数据分析 Agent",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx src/server.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node --import tsx src/server.ts",
    "generate:data": "tsx src/scripts/generate-sales.ts",
    "seed": "tsx src/scripts/seed-db.ts",
    "test": "node --test --import tsx \"tests/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build",
    "check": "npm run check:backend && npm run check:frontend",
    "check:backend": "tsc --noEmit",
    "check:frontend": "vue-tsc --noEmit -p frontend/tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "typebox": "^1.3.37",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
